digraph ER {
graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.0, fontname="Helvetica", bgcolor="white", label="PetTech — Modelo de datos (PostgreSQL 16 + PostGIS)", labelloc=t, fontsize=20];
