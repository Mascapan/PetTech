digraph ER {
graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.0, fontname="Helvetica", bgcolor="white", label="PetTech — Modelo de datos (PostgreSQL 16 + PostGIS) · vista resumida", labelloc=t, fontsize=20];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#4a5e5c", arrowhead=crow, arrowtail=tee, dir=both];
subgraph cluster_accounts { label="Cuentas"; style="rounded,filled"; fillcolor="#e0f2f1"; color="#b2dfdb"; fontsize=13;
User [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#00695c"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#4a5e5c">accounts_user</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#4a5e5c" POINT-SIZE="8">+ 11 campos</FONT></TD></TR></TABLE>>];
PasswordResetCode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#00695c"><FONT COLOR="white"><B>PasswordResetCode</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#4a5e5c">accounts_passwordresetcode</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ User</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#4a5e5c" POINT-SIZE="8">+ 5 campos</FONT></TD></TR></TABLE>>];
AccountDeletionRequest [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#00695c"><FONT COLOR="white"><B>AccountDeletionRequest</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#4a5e5c">accounts_accountdeletionrequest</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ User</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#4a5e5c" POINT-SIZE="8">+ 5 campos</FONT></TD></TR></TABLE>>];
}
subgraph cluster_pets { label="Mascotas"; style="rounded,filled"; fillcolor="#fff1cc"; color="#b2dfdb"; fontsize=13;
Pet [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#00695c"><FONT COLOR="white"><B>Pet</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#4a5e5c">pets_pet</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">owner_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ User</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#4a5e5c" POINT-SIZE="8">+ 11 campos</FONT></TD></TR></TABLE>>];
}
subgraph cluster_clinics { label="Veterinarias"; style="rounded,filled"; fillcolor="#ddebfa"; color="#b2dfdb"; fontsize=13;
Clinic [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#00695c"><FONT COLOR="white"><B>Clinic</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#4a5e5c">clinics_clinic</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">account_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ User</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#4a5e5c" POINT-SIZE="8">+ 19 campos</FONT></TD></TR></TABLE>>];
OpeningHour [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#00695c"><FONT COLOR="white"><B>OpeningHour</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#4a5e5c">clinics_openinghour</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">clinic_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ Clinic</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#4a5e5c" POINT-SIZE="8">+ 3 campos</FONT></TD></TR></TABLE>>];
ProfessionalMembership [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#00695c"><FONT COLOR="white"><B>ProfessionalMembership</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#4a5e5c">clinics_professionalmembership</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">professional_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ User</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">clinic_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ Clinic</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#4a5e5c" POINT-SIZE="8">+ 5 campos</FONT></TD></TR></TABLE>>];
}
subgraph cluster_access_control { label="Control de acceso y bitácora"; style="rounded,filled"; fillcolor="#fde2df"; color="#b2dfdb"; fontsize=13;
AccessRequest [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#00695c"><FONT COLOR="white"><B>AccessRequest</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#4a5e5c">access_control_accessrequest</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">pet_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ Pet</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">clinic_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ Clinic</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">professional_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ User</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#4a5e5c" POINT-SIZE="8">+ 6 campos</FONT></TD></TR></TABLE>>];
AuditEvent [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#00695c"><FONT COLOR="white"><B>AuditEvent</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#4a5e5c">access_control_auditevent</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ User</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">clinic_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ Clinic</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">pet_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ Pet</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#4a5e5c" POINT-SIZE="8">+ 7 campos</FONT></TD></TR></TABLE>>];
}
subgraph cluster_clinical_records { label="Ficha clínica"; style="rounded,filled"; fillcolor="#ddf3e4"; color="#b2dfdb"; fontsize=13;
ClinicalEntry [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#00695c"><FONT COLOR="white"><B>ClinicalEntry</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#4a5e5c">clinical_records_clinicalentry</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">pet_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ Pet</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">created_by_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ User</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">clinic_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ Clinic</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">corrects_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ ClinicalEntry</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">source_attachment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ Attachment</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#4a5e5c" POINT-SIZE="8">+ 26 campos</FONT></TD></TR></TABLE>>];
Attachment [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#00695c"><FONT COLOR="white"><B>Attachment</B></FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#4a5e5c">clinical_records_attachment</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">pet_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ Pet</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">entry_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ ClinicalEntry</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">uploaded_by_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ User</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT COLOR="#9b2c20" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">clinic_id</TD><TD ALIGN="LEFT"><FONT COLOR="#4a5e5c" POINT-SIZE="9">→ Clinic</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#4a5e5c" POINT-SIZE="8">+ 10 campos</FONT></TD></TR></TABLE>>];
}
User -> PasswordResetCode [label="user", arrowhead=crow];
User -> AccountDeletionRequest [label="user", arrowhead=crowodot];
User -> Pet [label="owner", arrowhead=crow];
User -> Clinic [label="account", arrowhead=teeodot];
Clinic -> OpeningHour [label="clinic", arrowhead=crow];
User -> ProfessionalMembership [label="professional", arrowhead=crow];
Clinic -> ProfessionalMembership [label="clinic", arrowhead=crow];
Pet -> AccessRequest [label="pet", arrowhead=crow];
Clinic -> AccessRequest [label="clinic", arrowhead=crow];
User -> AccessRequest [label="professional", arrowhead=crow];
User -> AuditEvent [label="actor", arrowhead=crowodot];
Clinic -> AuditEvent [label="clinic", arrowhead=crowodot];
Pet -> AuditEvent [label="pet", arrowhead=crowodot];
Pet -> ClinicalEntry [label="pet", arrowhead=crow];
User -> ClinicalEntry [label="created_by", arrowhead=crow];
Clinic -> ClinicalEntry [label="clinic", arrowhead=crowodot];
ClinicalEntry -> ClinicalEntry [label="corrects", arrowhead=teeodot];
Attachment -> ClinicalEntry [label="source_attachment", arrowhead=crowodot];
Pet -> Attachment [label="pet", arrowhead=crow];
ClinicalEntry -> Attachment [label="entry", arrowhead=crowodot];
User -> Attachment [label="uploaded_by", arrowhead=crow];
Clinic -> Attachment [label="clinic", arrowhead=crowodot];
}