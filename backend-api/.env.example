# =============================================================
# PetTech backend — variables de entorno (PLANTILLA)
# Copia este archivo como ".env" en esta misma carpeta y completa los valores.
# El archivo .env NUNCA se sube a Git (está en .gitignore).
# =============================================================

# Ambiente: config.settings.development (local) | config.settings.production (piloto)
DJANGO_SETTINGS_MODULE=config.settings.development

# Clave secreta: en desarrollo cualquier texto largo; en el piloto, una clave aleatoria
# generada con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-cambia-esta-clave-solo-para-desarrollo-local-0000000000
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Base de datos PostgreSQL + PostGIS (esquema postgis://)
# Formato: postgis://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgis://pettech:cambia_esta_clave@localhost:5432/pettech

# Windows + GeoDjango (OSGeo4W): descomenta y ajusta si Django no encuentra GDAL/GEOS.
# GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal309.dll
# GEOS_LIBRARY_PATH=C:\OSGeo4W\bin\geos_c.dll

# Duración de sesiones por rol
TOKEN_TTL_TUTOR_DAYS=7
TOKEN_TTL_PROFESSIONAL_HOURS=12
MAX_TOKENS_PER_USER=5

# Límites de solicitudes (anti fuerza bruta)
THROTTLE_AUTH=10/min

# Versión de la política de privacidad vigente (se registra al aceptar)
PRIVACY_POLICY_VERSION=2026-11-borrador

# Solo desarrollo: contraseña de las cuentas ficticias creadas por "seed_demo"
DEMO_PASSWORD=PetTech-Demo-2026

DJANGO_LOG_LEVEL=INFO
